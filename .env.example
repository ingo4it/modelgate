# ---- runtime ----
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# ---- datastores ----
DATABASE_URL=postgres://modelgate:modelgate@localhost:5432/modelgate?schema=public
REDIS_URL=redis://localhost:6379

# ---- model provider (answering) ----
ANTHROPIC_API_KEY=sk-ant-...
MODEL_PRIMARY=claude-sonnet-5
MODEL_FALLBACK=claude-haiku-4-5
MODEL_MAX_TOKENS=1024
# ms before the primary is considered too slow and the fallback is tried
MODEL_TIMEOUT_MS=8000

# ---- embeddings (Anthropic has no embeddings endpoint; Voyage is the
#      Anthropic-recommended provider) ----
VOYAGE_API_KEY=pa-...
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# ---- retrieval ----
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
CHUNK_TOKENS=400
CHUNK_OVERLAP=64

# ---- cache ----
EXACT_CACHE_TTL=86400
SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_MIN_SIMILARITY=0.97
# bump to invalidate every cached answer at once (e.g. after a prompt change)
CORPUS_VERSION=2026-09-01

# ---- guardrails ----
MAX_QUESTION_CHARS=1200
